# Dependencias
node_modules/
yarn.lock

# Variables de entorno — todo .env queda fuera salvo el ejemplo
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Compilados
dist/
build/

# Temporal
temp/
tmp/

# Base de datos — dumps y backups fuera del repo…
*.sql
backup.sql
# …pero las migraciones SÍ se versionan: son parte del esquema, no un dump.
!db/migrations/*.sql

# Sistema operativo
.DS_Store
Thumbs.db

# Testing
coverage/
.nyc_output/

# Scripts de prueba/QA locales (carga, concurrencia, verificación manual) —
# no son parte del código de la app. El plan de pruebas (qa/test-plan.md) sí
# se versiona: es documentación, no un script.
qa/*.js
qa_timeout_test_out.txt
*_test_out.txt

# Herramientas de agentes / QA local
.claude/
.playwright-mcp/
*.png
*.jpg
*.jpeg
*.webp

# Docs redundantes — viven fuera del repo
ARCHITECTURE.md
QUICKSTART.md
VERIFICATION_CHECKLIST.md
docs/SUPABASE_AUTH.md
.vercel
.env*
