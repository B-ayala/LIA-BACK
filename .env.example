# Configuración general
NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL / Supabase
DB_HOST=your_db_host.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=postgres

# Frontend — allowlist de CORS. Acepta varios orígenes separados por coma (sin espacios).
# En producción debe incluir TODOS los dominios del front, o el navegador bloquea las requests.
# Ej: http://localhost:5173,https://damiana-bella.vercel.app,https://lia-front-beta.vercel.app
# En desarrollo (NODE_ENV != production) cualquier localhost/127.0.0.1 se acepta igual.
FRONTEND_URL=http://localhost:5173

# Cloudinary (requerido para /api/cloudinary/*: imágenes, carpetas, uso, firma de uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Supabase Auth (requerido por authMiddleware para verificar access tokens)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Mercado Pago (requerido para /api/orders/mp-preference, mp-confirm y mp-webhook)
MP_ACCESS_TOKEN=your_mp_access_token
# URL pública del webhook (opcional; ej: https://tu-dominio.com/api/orders/mp-webhook)
# MP_WEBHOOK_URL=
# Clave secreta del webhook (panel de MP → Webhooks → "Firma secreta").
# Si está presente, se valida la firma x-signature y se rechaza lo que no cuadre.
# Si falta, el webhook igual revalida cada pago contra la API de MP.
# MP_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Concurrencia y carga (todas OPCIONALES: los defaults ya son los recomendados)
# ─────────────────────────────────────────────────────────────────────────────

# Pool de PostgreSQL. OJO: el pooler de Supabase en modo sesión limita el
# proyecto a 15 clientes y devuelve EMAXCONNSESSION al pasarse. No subir
# DB_POOL_MAX por encima de ese techo sin ampliarlo antes en Supabase.
# DB_POOL_MAX=12
# DB_POOL_MIN=2
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECTION_TIMEOUT_MS=5000
# Corta queries colgadas para que no retengan una conexión del pool.
# DB_STATEMENT_TIMEOUT_MS=10000
# DB_QUERY_TIMEOUT_MS=10000

# Control de concurrencia (bulkhead + cola). Por encima de la cola se responde
# 503 con Retry-After en vez de dejar que todo se degrade.
# Default de MAX_CONCURRENT_REQUESTS = DB_POOL_MAX * 2.
# MAX_CONCURRENT_REQUESTS=24
# MAX_QUEUED_REQUESTS=200
# QUEUE_TIMEOUT_MS=8000

# Cachés en memoria, en SEGUNDOS. 0 desactiva cada una.
# Catálogo (productos): cuanto más alto, menos carga y más desfasaje de stock.
# CACHE_TTL_PRODUCTS_SECONDS=20
# Analítica del asistente admin.
# CACHE_TTL_INSIGHTS_SECONDS=60
# Verificación de token contra Supabase Auth. Un token revocado sigue siendo
# aceptado como máximo este tiempo: no subirlo sin entender ese trade-off.
# CACHE_TTL_AUTH_SECONDS=30

# Nivel de log estructurado: debug | info | warn | error
# LOG_LEVEL=info
